# AI Model Provider: "runpod" (for local/self-hosted Qwen on RunPod) or "gemini"
MODEL_PROVIDER=runpod

# RunPod Pod Configuration (vLLM / Ollama / OpenAI-compatible endpoint)
# Example RunPod proxy URL: https://<pod-id>-8000.proxy.runpod.net/v1
# Example Direct IP URL: http://<runpod-ip>:<port>/v1
RUNPOD_ENDPOINT_URL=https://your-pod-id-8000.proxy.runpod.net/v1
RUNPOD_MODEL_NAME=qwen3:14b
RUNPOD_API_KEY=runpod

# Fallback / Alternative: Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash

# AI Service Settings
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
BACKEND_API_URL=http://localhost:5000/api
