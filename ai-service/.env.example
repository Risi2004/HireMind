# AI Model Provider: "openrouter" or "gemini"
MODEL_PROVIDER=openrouter

# OpenRouter Configuration
# The model identifier to use with OpenRouter (e.g., qwen/qwen-2.5-72b-instruct, deepseek/deepseek-chat, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct)
aimodel=qwen/qwen-2.5-72b-instruct
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback / Alternative: Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash

# AI Service Settings
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
BACKEND_API_URL=http://localhost:5000/api
