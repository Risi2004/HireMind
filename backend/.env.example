PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/hiremind
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Cloudflare R2 Storage (Private S3-compatible Bucket)
# No public access needed. Avatars are served securely via backend proxy stream.
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=hire-mind

# Email / SMTP Configuration for OTP and Onboarding
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="HireMind Team" <noreply@hiremind.com>
